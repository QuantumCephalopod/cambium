{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sss-live",
  "main": "src/index.js",
  "compatibility_date": "2026-09-13",

  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_STATE",
        "class_name": "LiveState"
      }
    ]
  },

  "exports": {
    "LiveState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
