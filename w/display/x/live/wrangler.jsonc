{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sss-live",
  "main": "src/index.js",
  "compatibility_date": "2026-09-13",
  "workers_dev": false,

  "routes": [
    {
      "pattern": "sss.saarland/__live/home",
      "zone_name": "sss.saarland"
    }
  ],

  "r2_buckets": [
    {
      "binding": "SHADOW",
      "bucket_name": "sss-shadow"
    }
  ],

  "exports": {
    "LiveState": {
      "type": "durable-object",
      "state": "deleted"
    }
  ]
}
